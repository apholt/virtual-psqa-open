# ------------------------------------------------------------------
# Virtual PSQA — Windows production configuration template
# Copy this file to `.env` in the backend folder to customize settings.
# ------------------------------------------------------------------

# ---- DICOM auto-ingest (folder watcher) ----
# Optional: UNC path or mapped drive the TPS exports plans / RT records to.
# DICOM_WATCH_FOLDER=C:\PSQA_incoming
DICOM_SETTLE_SECONDS=5

# ---- Orthanc PACS / VNA server integration ----
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
ORTHANC_TIMEOUT_SECONDS=120

# ==================================================================
# openMCsquare (real Monte Carlo)
# ==================================================================
# Set to False to use the real binary, or True for fast mock testing
MCSQUARE_SIMULATION_MODE=False

# Relative to backend/ directory (or absolute path)
MCSQUARE_HOME=..\MCsquare

# The openMCsquare executable (Windows build).
# Options: MCsquare_win_avx2.exe, MCsquare_win.exe, MCsquare_win_avx.exe, MCsquare_win_sse4.exe
MCSQUARE_EXE=MCsquare_win_avx2.exe
MCSQUARE_BINARY=..\MCsquare\MCsquare_win_avx2.exe

# Commissioned Beam Data Library (BDL)
MCSQUARE_BDL_PATH=..\MCsquare\BDL
MCSQUARE_BDL_FILE=..\MCsquare\BDL\GantryTrial5.txt
MCSQUARE_BDL_NAME=auto
MCSQUARE_SCANNER=default

# HU -> density / material calibration for CT scanner
MCSQUARE_HU_DENSITY_FILE=..\MCsquare\Scanners\default\HU_Density_Conversion.txt
MCSQUARE_HU_MATERIAL_FILE=..\MCsquare\Scanners\default\HU_Material_Conversion.txt

# Geometry: auto, patient_ct, or water
MCSQUARE_GEOMETRY=auto

# Simulation statistics: 0 = all CPU cores
MCSQUARE_PRIMARIES=10000000
MCSQUARE_NUM_THREADS=0
MCSQUARE_STAT_UNCERTAINTY=1.5
MCSQUARE_DOSE_TO_WATER=Disabled
PROTON_RBE=1.1

# ==================================================================
# Storage & Database paths (relative to backend/)
# ==================================================================
DICOM_STORE_PATH=.\data\dicom_store
RESULTS_PATH=.\data\results
DATABASE_URL=sqlite:///.\data\psqa.db
PIPELINE_AUTO_RUN=True
DICOM_WATCH_RECURSIVE=True

# ==================================================================
# Gamma criteria (AAPM TG-218)
# ==================================================================
GAMMA_MCSQUARE_VS_TPS_DD=3.0
GAMMA_MCSQUARE_VS_TPS_DTA=3.0
GAMMA_MCSQUARE_VS_TPS_THRESHOLD=90.0
GAMMA_LOG_VS_TPS_DD=2.0
GAMMA_LOG_VS_TPS_DTA=2.0
GAMMA_LOG_VS_TPS_THRESHOLD=90.0
GAMMA_EVAL_VOXEL_MM=1.0
DOSE_THRESHOLD_PERCENT=10.0
