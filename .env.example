# ============================================================
#  Virtual PSQA Environment Configuration (HIPAA Safeguards)
# ============================================================

# 1. Access Control & Unique Identification (§ 164.312(a)(2)(i))
AUTH_ENABLED=true
AUTH_USERNAME=admin
# Run `openssl rand -hex 32` or `python -c "import secrets; print(secrets.token_hex(32))"` to generate:
AUTH_SECRET_KEY=generate_a_random_32_byte_hex_key_for_production
AUTH_SESSION_COOKIE=vpsqa_session

# 2. Inactivity Auto-Logoff (§ 164.312(a)(2)(iii))
AUTH_SESSION_EXPIRE_MINUTES=15

# 3. Transmission Security (§ 164.312(e)) - TLS/HTTPS
SSL_ENABLED=true
SSL_KEYFILE=./certs/key.pem
SSL_CERTFILE=./certs/cert.pem

# Database & Storage
DATABASE_URL=sqlite:///./data/psqa.db
DICOM_STORE_PATH=./data/dicom_store
RESULTS_PATH=./data/results

# openMCsquare Engine
MCSQUARE_SIMULATION_MODE=false

# 4. Distributed MCsquare Cluster Computing
CLUSTER_ENABLED=false
# JSON list of worker node URLs, e.g. ["http://192.168.1.105:8001", "http://192.168.1.106:8001"]
CLUSTER_NODES=[]
CLUSTER_TIMEOUT_SECONDS=1800
CLUSTER_IDLE_MINUTES=5.0
CLUSTER_MAX_CPU_PCT=30.0

